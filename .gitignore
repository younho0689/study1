# ─────────────────────────────────────────────
# 휴게소 시설점검 실습 프로젝트 .gitignore
# ─────────────────────────────────────────────

# 1) 의존성 폴더 — `npm install`로 언제든 다시 만들 수 있음 (용량 큼)
node_modules/

# 2) 빌드 결과물 — `npm run build`로 생성, Vercel이 배포 때 직접 빌드함
dist/
dist-ssr/
*.local

# 3) 환경변수 파일 — Supabase URL·키가 들어가므로 절대 업로드 금지
#    (.env.example은 빈 값 템플릿이라 업로드해도 됨)
.env
.env.*
!.env.example

# 4) 배포·DB 도구가 만드는 로컬 설정
.vercel/
supabase/.temp/
supabase/.branches/

# 5) Claude Code 로컬 설정 (개인 작업 환경용)
.claude/

# 6) 로그 파일
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7) 에디터 설정
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo
*.sw?

# 8) 운영체제가 만드는 파일
.DS_Store
Thumbs.db
desktop.ini

# 9) 테스트·캐시
coverage/
.cache/
.eslintcache
